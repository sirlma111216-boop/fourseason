{
  "name": "four-seasons-map",
  "version": "1.0.0",
  "private": true,
  "description": "사계절의 지도 — 친구들과 같은 탐험 카드로 각자 지도를 그리는 온라인 동시 진행 보드게임 (Cloudflare Workers + Durable Objects)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:net": "node tests/net/run-net-tests.mjs",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  }
}
